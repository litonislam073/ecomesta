# Database
DATABASE_URL=postgresql://ecomesta:CHANGE_ME_LOCAL_PASSWORD@localhost:5432/ecomesta?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT (generate strong random secrets for production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Application URLs
API_URL=http://localhost:3001
API_PORT=3001
WEB_URL=http://localhost:3000
MERCHANT_URL=http://localhost:3002
ADMIN_URL=http://localhost:3003

# Merchant / Next.js public API base (browser)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# S3-compatible object storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ecomesta
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Platform
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003

# Development seed (never use these values in production)
SEED_SUPER_ADMIN_EMAIL=admin@ecomesta.local
SEED_SUPER_ADMIN_PASSWORD=CHANGE_ME_SEED_PASSWORD_MIN_12
