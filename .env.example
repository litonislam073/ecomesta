# Database
DATABASE_URL=postgresql://ecomesta:CHANGE_ME_LOCAL_PASSWORD@localhost:5432/ecomesta?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT (generate strong random secrets for production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Application URLs
API_URL=http://localhost:3001
API_PORT=3001
WEB_URL=http://localhost:3000
MERCHANT_URL=http://localhost:3002
ADMIN_URL=http://localhost:3003

# Next.js public API base used by the browser in apps/web, apps/merchant and apps/admin.
# Must include the /api/v1 version prefix. Requests are sent with credentials so the
# refresh cookie works, which means this origin must also appear in CORS_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Browser-facing app URLs (platform homepage CTAs + cookie SameSite domains).
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_MERCHANT_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3003
# Apex used by apps/web to treat www/apex as SaaS marketing (not storefront).
NEXT_PUBLIC_PLATFORM_ROOT_DOMAIN=ecomesta.local
# Optional local storefront fallback — leave empty so `/` stays the platform homepage.
NEXT_PUBLIC_DEFAULT_STORE_SLUG=

# Marketing site (apps/web). Canonical origin for SEO metadata, sitemap and robots;
# falls back to NEXT_PUBLIC_WEB_URL. Contact email and Search Console token are optional.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# S3-compatible object storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ecomesta
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Platform
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003

# Root domain for store storefront subdomains ({store-slug}.{PLATFORM_ROOT_DOMAIN}).
# Use ecomesta.com (or your own apex) in production.
PLATFORM_ROOT_DOMAIN=ecomesta.local

# How often (ms) the API moves ended trials into the 7-day grace period and suspends
# stores whose grace period has ended. Default 900000 (15 minutes); 0 disables the timer
# (subscriptions are still evaluated when merchants or shoppers hit the API).
# SUBSCRIPTION_EVALUATION_INTERVAL_MS=900000

# Transactional email (API only — never prefix these with NEXT_PUBLIC_).
# EMAIL_PROVIDER_MODE: console (default in development: logs event + subject, sends
# nothing), smtp (real delivery), or disabled. Production refuses console mode.
EMAIL_PROVIDER_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@ecomesta.local
SMTP_FROM_NAME=Ecomesta
# true = implicit TLS (usually port 465); false = STARTTLS is required (port 587).
SMTP_SECURE=false
# Public marketing origin used for the email logo and footer links (defaults to WEB_URL).
APP_PUBLIC_URL=
# Where merchant support requests are delivered (Reply-To is the merchant).
SUPPORT_EMAIL=support@ecomesta.local
# Optional (development only): also write rendered emails as .html files here.
# EMAIL_PREVIEW_DIR=/tmp/ecomesta-emails
# How often (ms) queued emails are retried. Default 30000.
# EMAIL_DISPATCH_INTERVAL_MS=30000

# Website AI support agent (OpenAI, server-side only). Empty = the chat widget
# tells visitors the assistant is unavailable and offers human support.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AI_SUPPORT_DAILY_REQUEST_LIMIT=5000
# Days a support chat is kept after its last message (1-3650, default 365).
# Older chats are hidden at once and deleted by a cleanup that runs every 6 hours.
# AI_SUPPORT_RETENTION_DAYS=365

# Manual subscription payments (bKash / Nagad / Rocket / Upay) are reported to
# this inbox for review. Defaults to ecomestabd@gmail.com when empty.
BILLING_NOTIFICATION_EMAIL=

# Steadfast Courier API base URL. Leave unset for the official
# https://portal.packzy.com/api/v1; only point it elsewhere for tests.
# Merchants' Steadfast API keys are saved per store (encrypted), not here.
# STEADFAST_BASE_URL=

# Sign in with Google: OAuth web client ID (authorized JavaScript origin
# http://localhost:3002). Leave empty to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=

# Development seed (never use these values in production)
SEED_SUPER_ADMIN_EMAIL=admin@ecomesta.local
SEED_SUPER_ADMIN_PASSWORD=CHANGE_ME_SEED_PASSWORD_MIN_12

# Payment provider secrets encryption (32-byte hex preferred)
PAYMENT_SECRETS_ENCRYPTION_KEY=change-me-64-hex-chars-payment-secrets-key-32bytes
