# Ecomesta — VPS staging / production environment.
#
#   cp .env.production.example .env.production && chmod 600 .env.production
#
# Fill every CHANGE_ME / example.com value. `.env.production` is gitignored and
# must never be committed, baked into an image, or pasted into source files.
# The API refuses to start in production when a secret is missing, a
# placeholder, too short/predictable, or a URL points at localhost / plain http.
# scripts/deploy-staging.sh performs the same checks before building.
#
# Generate secrets on the VPS (hex output is URL-safe):
#   openssl rand -hex 24   # POSTGRES_PASSWORD, REDIS_PASSWORD
#   openssl rand -hex 48   # JWT_ACCESS_SECRET, JWT_REFRESH_SECRET (different values)
#   openssl rand -hex 32   # PAYMENT_SECRETS_ENCRYPTION_KEY (64 hex chars = AES-256 key)
#
# Staging must only ever hold Stripe *test* keys and SSLCommerz *sandbox*
# credentials. Payment credentials are not env vars: merchants enter them in
# the dashboard and they are stored AES-256-GCM encrypted with the key below.

NODE_ENV=production

# --- PostgreSQL (compose service `postgres`, never published to the host) ---
POSTGRES_USER=ecomesta
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ecomesta
# Password must equal POSTGRES_PASSWORD; host must be postgres:5432.
DATABASE_URL=postgresql://ecomesta:CHANGE_ME@postgres:5432/ecomesta?schema=public

# --- Redis (compose service `redis`, requirepass, never published) ---
REDIS_PASSWORD=CHANGE_ME
# Password must equal REDIS_PASSWORD.
REDIS_URL=redis://:CHANGE_ME@redis:6379

# --- Auth (≥32 chars, random, access ≠ refresh) ---
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Payment provider secrets at rest (AES-256-GCM). 64 hex chars. ---
# Changing this key makes previously saved gateway credentials undecryptable;
# back it up separately from database backups.
PAYMENT_SECRETS_ENCRYPTION_KEY=CHANGE_ME

# --- Public URLs (https only; nginx routes by these exact hostnames) ---
# Convention: api./merchant./admin. under PLATFORM_ROOT_DOMAIN, storefront on
# the apex (or www.), stores on {slug}.PLATFORM_ROOT_DOMAIN.
PLATFORM_ROOT_DOMAIN=example.com
API_URL=https://api.example.com
WEB_URL=https://example.com
MERCHANT_URL=https://merchant.example.com
ADMIN_URL=https://admin.example.com
# Extra CORS origins beyond WEB/MERCHANT/ADMIN_URL (comma-separated, https only).
CORS_ORIGINS=https://www.example.com

# API_PORT is fixed to 3001 inside the compose network; TRUST_PROXY=true and
# TRUSTED_PROXY_HOPS=1 are set by docker-compose.prod.yml because nginx is the
# only way to reach the apps. Do not set them for a directly exposed process.
# The web container also gets API_INTERNAL_URL=http://api:3001/api/v1 from
# compose so storefront page renders stay on the private network.

# --- Transactional email (API container only; never NEXT_PUBLIC_) ---
# Leave EMAIL_PROVIDER_MODE unset/disabled until SMTP is ready: the API still
# starts but sends nothing and logs a warning. With smtp, the API refuses to
# start unless every value below is set, SMTP_PASSWORD is not a placeholder,
# SMTP_HOST is not local and APP_PUBLIC_URL is https. console is rejected.
# Configure SPF, DKIM and DMARC for the SMTP_FROM_EMAIL domain at your provider.
EMAIL_PROVIDER_MODE=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Ecomesta
# true for implicit TLS on 465; false requires STARTTLS on 587.
SMTP_SECURE=false
APP_PUBLIC_URL=https://example.com
SUPPORT_EMAIL=support@example.com

# Optional: pino level (fatal|error|warn|info|debug). Default info.
LOG_LEVEL=info

# Shared host only (docker-compose.shared-host.yml, docs/deployment.md §17):
# loopback port the host web server proxies to.
ECOMESTA_HTTP_PORT=8480

# --- Next.js build-time values (inlined into browser bundles; public only) ---
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_WEB_URL=https://example.com
NEXT_PUBLIC_MERCHANT_URL=https://merchant.example.com
NEXT_PUBLIC_PLATFORM_ROOT_DOMAIN=example.com
# Leave empty in staging/production (localhost-only convenience).
NEXT_PUBLIC_DEFAULT_STORE_SLUG=
# Marketing canonical origin used for canonical URLs, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://example.com
# Optional: shown on /contact; Search Console HTML-tag verification token.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- First-deploy seed only (`docker compose ... run --rm seed`) ---
# Creates Bangladesh locations, built-in themes, the first Super Admin, a
# `starter` plan and an ACTIVE public `demo-store` (docs/deployment.md §6).
# Prefer passing SEED_SUPER_ADMIN_PASSWORD on the command line and leaving it
# empty here; rotate it from the admin UI after first login.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
