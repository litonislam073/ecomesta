{
  "name": "@ecomesta/utils",
  "version": "0.1.0",
  "private": true,
  "description": "Shared utility functions for Ecomesta",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./marketing-content": {
      "types": "./dist/marketing-content/index.d.ts",
      "default": "./dist/marketing-content/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "marketing-content": [
        "./dist/marketing-content/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"No lint configured for @ecomesta/utils\""
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
