generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum StoreStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DRAFT
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  INVITED
  SUSPENDED
}

enum TenantRole {
  OWNER
  ADMIN
  STAFF
}

enum StoreRole {
  STORE_MANAGER
  STORE_STAFF
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductType {
  PHYSICAL
  DIGITAL
  SERVICE
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RESERVATION
  RELEASE
  ADJUSTMENT
  RETURN
  DAMAGE
}

enum CustomerAddressType {
  BILLING
  SHIPPING
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  PARTIALLY_PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  RETURNED
  CANCELLED
}

enum PaymentProvider {
  COD
  STRIPE
  BKASH
  NAGAD
  SSL_COMMERZ
  OTHER
  /// Deterministic provider for automated tests / local online-payment flows.
  TEST
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_WALLET
  OTHER
}

enum ShippingProvider {
  MANUAL
  PATHAO
  STEADFAST
  REDX
  OTHER
}

enum ShippingMethodType {
  FLAT
  WEIGHT_BASED
  FREE
  EXTERNAL
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum DomainType {
  SUBDOMAIN
  CUSTOM_DOMAIN
}

enum DomainStatus {
  PENDING
  VERIFIED
  ACTIVE
  FAILED
  DISABLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
  SEMI_ANNUAL
}

/// Mobile wallets merchants pay Ecomesta subscriptions with (manual transfer).
enum ManualPaymentMethod {
  BKASH
  NAGAD
  ROCKET
  UPAY
}

/// Review state of a manually submitted subscription payment.
enum BillingPaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  SYSTEM
  ORDER
  INVENTORY
  BILLING
  SECURITY
  OTHER
}

// ---------------------------------------------------------------------------
// Infrastructure (Phase 1)
// ---------------------------------------------------------------------------

/// Connectivity probe retained from Phase 1 foundation.
model HealthProbe {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_probes")
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

model User {
  id              String       @id @default(uuid()) @db.Uuid
  email           String       @unique @db.Citext
  passwordHash    String       @map("password_hash")
  firstName       String?      @map("first_name")
  lastName        String?      @map("last_name")
  phone           String?
  avatarUrl       String?      @map("avatar_url")
  /// Google account `sub` claim once the user has signed in with Google.
  googleSub       String?      @unique @map("google_sub")
  platformRole    PlatformRole @default(USER) @map("platform_role")
  status          UserStatus   @default(ACTIVE)
  emailVerifiedAt DateTime?    @map("email_verified_at")
  lastLoginAt     DateTime?    @map("last_login_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  tenantMemberships        TenantUser[]
  storeMemberships         StoreUser[]
  mediaUploads             Media[]          @relation("MediaUploadedBy")
  auditLogs                AuditLog[]
  notifications            Notification[]
  authSessions             AuthSession[]
  authTokens               AuthToken[]
  emailDeliveries          EmailDelivery[]
  billingPaymentsSubmitted BillingPayment[] @relation("BillingPaymentSubmittedBy")
  billingPaymentsReviewed  BillingPayment[] @relation("BillingPaymentReviewedBy")

  @@index([status])
  @@index([platformRole])
  @@map("users")
}

enum AuthTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

/// Single-use emailed tokens. Only the SHA-256 hash of the token is stored.
model AuthToken {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  purpose     AuthTokenPurpose
  tokenHash   String           @unique @map("token_hash")
  expiresAt   DateTime         @map("expires_at")
  usedAt      DateTime?        @map("used_at")
  requestedIp String?          @map("requested_ip")
  createdAt   DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenHash])
  @@map("auth_sessions")
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique @db.Citext
  status    TenantStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  stores          Store[]
  memberships     TenantUser[]
  subscriptions   Subscription[]
  billingPayments BillingPayment[]
  auditLogs       AuditLog[]
  notifications   Notification[]

  @@index([status])
  @@map("tenants")
}

model Store {
  id                            String       @id @default(uuid()) @db.Uuid
  tenantId                      String       @map("tenant_id") @db.Uuid
  name                          String
  slug                          String       @db.Citext
  description                   String?
  logoUrl                       String?      @map("logo_url")
  faviconUrl                    String?      @map("favicon_url")
  status                        StoreStatus  @default(DRAFT)
  /// Set only while the platform subscription has lapsed: the status to restore
  /// once payment is confirmed. Null for stores suspended for any other reason.
  statusBeforeBillingSuspension StoreStatus? @map("status_before_billing_suspension")
  currency                      String       @default("BDT") @db.Char(3)
  timezone                      String       @default("Asia/Dhaka")
  /// Storefront content language (`en-BD` or `bn-BD` for merchant-created stores).
  locale                        String       @default("en-BD")
  /// Public store contact details shown on the storefront.
  email                         String?      @db.VarChar(255)
  phone                         String?      @db.VarChar(40)
  address                       String?      @db.VarChar(500)
  /// Public checkout rejects orders without a phone number when true.
  checkoutRequirePhone          Boolean      @default(false) @map("checkout_require_phone")
  /// Public checkout drops customer notes when false.
  checkoutAllowOrderNotes       Boolean      @default(true) @map("checkout_allow_order_notes")
  /// Guests may cancel unpaid, unfulfilled PENDING/CONFIRMED orders from order tracking.
  allowCustomerCancellation     Boolean      @default(false) @map("allow_customer_cancellation")
  /// Storefront SEO (plain text; rendered through framework metadata only).
  seoTitle                      String?      @map("seo_title") @db.VarChar(120)
  seoDescription                String?      @map("seo_description") @db.VarChar(320)
  seoKeywords                   String[]     @default([]) @map("seo_keywords")
  ogTitle                       String?      @map("og_title") @db.VarChar(120)
  ogDescription                 String?      @map("og_description") @db.VarChar(320)
  ogImageUrl                    String?      @map("og_image_url") @db.VarChar(2048)
  seoIndexingEnabled            Boolean      @default(true) @map("seo_indexing_enabled")
  /// Monotonic counter used to allocate human order numbers (EM-100001…).
  orderSequence                 Int          @default(100000) @map("order_sequence")
  /// Set once when the optional sample catalog is imported; never cleared.
  demoCatalogImportedAt         DateTime?    @map("demo_catalog_imported_at")
  /// Set once when the merchant creates their first non-demo product; never cleared.
  firstRealProductCreatedAt     DateTime?    @map("first_real_product_created_at")
  createdAt                     DateTime     @default(now()) @map("created_at")
  updatedAt                     DateTime     @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  memberships            StoreUser[]
  products               Product[]
  productVariants        ProductVariant[]
  categories             Category[]
  inventoryItems         InventoryItem[]
  inventoryMovements     InventoryMovement[]
  customers              Customer[]
  orders                 Order[]
  payments               Payment[]
  paymentProviderConfigs PaymentProviderConfig[]
  paymentWebhookEvents   PaymentWebhookEvent[]
  shippingMethods        ShippingMethod[]
  shippingZones          ShippingZone[]
  shipments              Shipment[]
  coupons                Coupon[]
  media                  Media[]
  storeThemes            StoreTheme[]
  domains                Domain[]
  auditLogs              AuditLog[]
  notifications          Notification[]

  /// Globally unique: the slug is the `{slug}.{PLATFORM_ROOT_DOMAIN}` label and
  /// the public storefront API looks stores up by slug alone.
  @@unique([slug])
  @@index([tenantId])
  @@index([status])
  @@map("stores")
}

model TenantUser {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      TenantRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, role])
  @@map("tenant_users")
}

model StoreUser {
  id        String           @id @default(uuid()) @db.Uuid
  storeId   String           @map("store_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      StoreRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
  @@index([storeId, role])
  @@map("store_users")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  storeId          String        @map("store_id") @db.Uuid
  name             String
  slug             String        @db.Citext
  description      String?
  shortDescription String?       @map("short_description")
  status           ProductStatus @default(DRAFT)
  productType      ProductType   @default(PHYSICAL) @map("product_type")
  sku              String?
  barcode          String?
  basePrice        Decimal       @default(0) @map("base_price") @db.Decimal(12, 2)
  compareAtPrice   Decimal?      @map("compare_at_price") @db.Decimal(12, 2)
  costPrice        Decimal?      @map("cost_price") @db.Decimal(12, 2)
  trackInventory   Boolean       @default(true) @map("track_inventory")
  allowBackorder   Boolean       @default(false) @map("allow_backorder")
  /// Primary image URL; may be a storefront-relative path such as "/demo-catalog/x.jpg".
  imageUrl         String?       @map("image_url")
  /// Sample content created by the optional demo catalog import.
  isDemo           Boolean       @default(false) @map("is_demo")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  variants           ProductVariant[]
  categories         ProductCategory[]
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, sku])
  @@map("products")
}

model ProductVariant {
  id             String        @id @default(uuid()) @db.Uuid
  storeId        String        @map("store_id") @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  sku            String?
  barcode        String?
  name           String
  price          Decimal       @db.Decimal(12, 2)
  compareAtPrice Decimal?      @map("compare_at_price") @db.Decimal(12, 2)
  costPrice      Decimal?      @map("cost_price") @db.Decimal(12, 2)
  weight         Decimal?      @db.Decimal(12, 3)
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]

  @@index([storeId])
  @@index([productId])
  @@index([storeId, sku])
  @@map("product_variants")
}

model Category {
  id          String        @id @default(uuid()) @db.Uuid
  storeId     String        @map("store_id") @db.Uuid
  parentId    String?       @map("parent_id") @db.Uuid
  name        String
  slug        String        @db.Citext
  description String?
  imageUrl    String?       @map("image_url")
  status      ProductStatus @default(ACTIVE)
  /// Sample content created by the optional demo catalog import.
  isDemo      Boolean       @default(false) @map("is_demo")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  products ProductCategory[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([parentId])
  @@map("categories")
}

model ProductCategory {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model InventoryItem {
  id                String   @id @default(uuid()) @db.Uuid
  storeId           String   @map("store_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  variantId         String?  @map("variant_id") @db.Uuid
  quantity          Int      @default(0)
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  lowStockThreshold Int?     @map("low_stock_threshold")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  store   Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([storeId])
  @@index([productId])
  @@index([variantId])
  @@map("inventory_items")
}

model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  storeId       String                @map("store_id") @db.Uuid
  productId     String                @map("product_id") @db.Uuid
  variantId     String?               @map("variant_id") @db.Uuid
  type          InventoryMovementType
  quantity      Int
  referenceType String?               @map("reference_type")
  referenceId   String?               @map("reference_id")
  note          String?
  createdAt     DateTime              @default(now()) @map("created_at")

  store   Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([storeId])
  @@index([storeId, createdAt])
  @@index([productId])
  @@index([variantId])
  @@index([type])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  email     String?  @db.Citext
  phone     String?
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  addresses    CustomerAddress[]
  orders       Order[]
  couponUsages CouponUsage[]

  @@index([storeId])
  @@index([storeId, email])
  @@index([storeId, phone])
  @@map("customers")
}

model CustomerAddress {
  id           String              @id @default(uuid()) @db.Uuid
  customerId   String              @map("customer_id") @db.Uuid
  type         CustomerAddressType
  firstName    String?             @map("first_name")
  lastName     String?             @map("last_name")
  company      String?
  addressLine1 String              @map("address_line1")
  addressLine2 String?             @map("address_line2")
  city         String
  state        String?
  postalCode   String?             @map("postal_code")
  country      String              @db.Char(2)
  phone        String?
  /// Optional Bangladesh location FKs (live hierarchy).
  divisionId   String?             @map("division_id") @db.Uuid
  districtId   String?             @map("district_id") @db.Uuid
  upazilaId    String?             @map("upazila_id") @db.Uuid
  landmark     String?
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  division BdDivision? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  district BdDistrict? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  upazila  BdUpazila?  @relation(fields: [upazilaId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([customerId, type])
  @@index([divisionId])
  @@index([districtId])
  @@index([upazilaId])
  @@map("customer_addresses")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id                 String              @id @default(uuid()) @db.Uuid
  storeId            String              @map("store_id") @db.Uuid
  customerId         String?             @map("customer_id") @db.Uuid
  orderNumber        String              @map("order_number")
  /// Opaque guest-facing confirmation token (not sequential / not the UUID).
  publicReference    String?             @unique @map("public_reference")
  /// Client Idempotency-Key for public checkout; scoped per store.
  idempotencyKey     String?             @map("idempotency_key")
  status             OrderStatus         @default(PENDING)
  paymentStatus      PaymentStatus       @default(PENDING) @map("payment_status")
  fulfillmentStatus  FulfillmentStatus   @default(UNFULFILLED) @map("fulfillment_status")
  currency           String              @db.Char(3)
  subtotal           Decimal             @default(0) @db.Decimal(12, 2)
  discountTotal      Decimal             @default(0) @map("discount_total") @db.Decimal(12, 2)
  shippingTotal      Decimal             @default(0) @map("shipping_total") @db.Decimal(12, 2)
  taxTotal           Decimal             @default(0) @map("tax_total") @db.Decimal(12, 2)
  grandTotal         Decimal             @default(0) @map("grand_total") @db.Decimal(12, 2)
  /// Snapshot of shipping method display name at purchase (do not re-resolve).
  shippingMethodName String?             @map("shipping_method_name")
  /// Snapshot of shipping method type at purchase.
  shippingMethodType ShippingMethodType? @map("shipping_method_type")
  /// Snapshot of matched shipping zone name at purchase (null if store-wide / legacy).
  shippingZoneName   String?             @map("shipping_zone_name")
  /// Snapshot of coupon code applied at purchase (null if none).
  couponCode         String?             @map("coupon_code") @db.Citext
  customerNote       String?             @map("customer_note")
  internalNote       String?             @map("internal_note")
  /// Customer-safe cancellation explanation (never use for internal merchant notes).
  cancelReason       String?             @map("cancel_reason") @db.VarChar(500)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  items        OrderItem[]
  addresses    OrderAddress[]
  payments     Payment[]
  shipments    Shipment[]
  couponUsages CouponUsage[]

  @@unique([storeId, orderNumber])
  @@unique([storeId, idempotencyKey])
  @@index([storeId])
  @@index([storeId, createdAt])
  @@index([storeId, status])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  variantId   String?  @map("variant_id") @db.Uuid
  productName String   @map("product_name")
  variantName String?  @map("variant_name")
  sku         String?
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalPrice  Decimal  @map("total_price") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model OrderAddress {
  id           String              @id @default(uuid()) @db.Uuid
  orderId      String              @map("order_id") @db.Uuid
  type         CustomerAddressType
  firstName    String?             @map("first_name")
  lastName     String?             @map("last_name")
  company      String?
  addressLine1 String              @map("address_line1")
  addressLine2 String?             @map("address_line2")
  city         String
  state        String?
  postalCode   String?             @map("postal_code")
  country      String              @db.Char(2)
  phone        String?
  /// Guest/contact email captured at order time (not linked to Customer).
  email        String?             @db.Citext
  /// Optional location IDs (informational; historical truth is name snapshots).
  divisionId   String?             @map("division_id") @db.Uuid
  districtId   String?             @map("district_id") @db.Uuid
  upazilaId    String?             @map("upazila_id") @db.Uuid
  /// Snapshot names — never re-resolve from live location tables for history.
  divisionName String?             @map("division_name")
  districtName String?             @map("district_name")
  upazilaName  String?             @map("upazila_name")
  landmark     String?
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderId, type])
  @@map("order_addresses")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  storeId           String          @map("store_id") @db.Uuid
  orderId           String          @map("order_id") @db.Uuid
  /// Opaque internal payment attempt reference (not order number / UUID).
  internalReference String          @unique @map("internal_reference")
  attemptNumber     Int             @default(1) @map("attempt_number")
  provider          PaymentProvider
  providerPaymentId String?         @map("provider_payment_id")
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @db.Char(3)
  status            PaymentStatus   @default(PENDING)
  method            PaymentMethod   @default(OTHER)
  metadata          Json?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  store         Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order         Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  webhookEvents PaymentWebhookEvent[]

  @@unique([orderId, attemptNumber])
  @@index([storeId])
  @@index([orderId])
  @@index([storeId, status])
  @@index([orderId, attemptNumber])
  @@index([provider, providerPaymentId])
  @@map("payments")
}

/// Per-store payment provider configuration. Secrets are encrypted at rest.
model PaymentProviderConfig {
  id               String          @id @default(uuid()) @db.Uuid
  storeId          String          @map("store_id") @db.Uuid
  provider         PaymentProvider
  enabled          Boolean         @default(false)
  /// test | live
  mode             String          @default("test")
  /// Non-secret settings safe to return to merchants (publishable keys, display name).
  publicConfig     Json?           @map("public_config")
  /// AES-256-GCM ciphertext of secret JSON (never returned via API).
  encryptedSecrets String?         @map("encrypted_secrets")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, provider])
  @@index([storeId, enabled])
  @@map("payment_provider_configs")
}

/// Idempotent webhook processing ledger.
model PaymentWebhookEvent {
  id          String          @id @default(uuid()) @db.Uuid
  storeId     String?         @map("store_id") @db.Uuid
  paymentId   String?         @map("payment_id") @db.Uuid
  provider    PaymentProvider
  eventId     String          @map("event_id")
  eventType   String          @map("event_type")
  processedAt DateTime?       @map("processed_at")
  /// Non-secret summary of the verified event (no raw secrets).
  summary     Json?
  createdAt   DateTime        @default(now()) @map("created_at")

  store   Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([paymentId])
  @@index([storeId])
  @@map("payment_webhook_events")
}

// ---------------------------------------------------------------------------
// Bangladesh locations (GLOBAL — not store-scoped)
// ---------------------------------------------------------------------------

model BdDivision {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique
  name           String
  nameNormalized String   @map("name_normalized")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  districts             BdDistrict[]
  customerAddresses     CustomerAddress[]
  shippingZoneLocations ShippingZoneLocation[]

  @@index([active])
  @@map("bd_divisions")
}

model BdDistrict {
  id             String   @id @default(uuid()) @db.Uuid
  divisionId     String   @map("division_id") @db.Uuid
  code           String
  name           String
  nameNormalized String   @map("name_normalized")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  division              BdDivision             @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  upazilas              BdUpazila[]
  customerAddresses     CustomerAddress[]
  shippingZoneLocations ShippingZoneLocation[]

  @@unique([divisionId, code])
  @@unique([code])
  @@index([divisionId])
  @@index([active])
  @@map("bd_districts")
}

model BdUpazila {
  id             String   @id @default(uuid()) @db.Uuid
  districtId     String   @map("district_id") @db.Uuid
  code           String
  name           String
  nameNormalized String   @map("name_normalized")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  district              BdDistrict             @relation(fields: [districtId], references: [id], onDelete: Restrict)
  customerAddresses     CustomerAddress[]
  shippingZoneLocations ShippingZoneLocation[]

  @@unique([districtId, code])
  @@unique([code])
  @@index([districtId])
  @@index([active])
  @@map("bd_upazilas")
}

// ---------------------------------------------------------------------------
// Shipping
// ---------------------------------------------------------------------------

model ShippingZone {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  name      String
  active    Boolean  @default(true)
  /// Higher priority wins when multiple zones match a checkout location.
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store     Store                  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  locations ShippingZoneLocation[]
  methods   ShippingMethod[]

  @@index([storeId])
  @@index([storeId, active])
  @@index([storeId, priority])
  @@map("shipping_zones")
}

model ShippingZoneLocation {
  id         String  @id @default(uuid()) @db.Uuid
  zoneId     String  @map("zone_id") @db.Uuid
  storeId    String  @map("store_id") @db.Uuid
  divisionId String? @map("division_id") @db.Uuid
  districtId String? @map("district_id") @db.Uuid
  upazilaId  String? @map("upazila_id") @db.Uuid

  zone     ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  division BdDivision?  @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  district BdDistrict?  @relation(fields: [districtId], references: [id], onDelete: Restrict)
  upazila  BdUpazila?   @relation(fields: [upazilaId], references: [id], onDelete: Restrict)

  @@index([zoneId])
  @@index([storeId])
  @@index([divisionId])
  @@index([districtId])
  @@index([upazilaId])
  @@map("shipping_zone_locations")
}

model ShippingMethod {
  id                    String             @id @default(uuid()) @db.Uuid
  storeId               String             @map("store_id") @db.Uuid
  name                  String
  provider              ShippingProvider   @default(MANUAL)
  type                  ShippingMethodType @default(FLAT)
  price                 Decimal            @default(0) @db.Decimal(12, 2)
  active                Boolean            @default(true)
  configuration         Json?
  /// Null = store-wide / Phase 11 legacy (used when no zone matches, or as fallback).
  zoneId                String?            @map("zone_id") @db.Uuid
  freeShippingThreshold Decimal?           @map("free_shipping_threshold") @db.Decimal(12, 2)
  codAllowed            Boolean            @default(true) @map("cod_allowed")
  estimatedDelivery     String?            @map("estimated_delivery")
  sortOrder             Int                @default(0) @map("sort_order")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  store Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  zone  ShippingZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([storeId, active])
  @@index([storeId, zoneId])
  @@index([zoneId])
  @@map("shipping_methods")
}

model Shipment {
  id             String           @id @default(uuid()) @db.Uuid
  storeId        String           @map("store_id") @db.Uuid
  orderId        String           @map("order_id") @db.Uuid
  provider       ShippingProvider @default(MANUAL)
  trackingNumber String?          @map("tracking_number")
  status         ShipmentStatus   @default(PENDING)
  shippedAt      DateTime?        @map("shipped_at")
  deliveredAt    DateTime?        @map("delivered_at")
  metadata       Json?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([storeId])
  @@index([orderId])
  @@index([storeId, status])
  @@map("shipments")
}

// ---------------------------------------------------------------------------
// Coupons
// ---------------------------------------------------------------------------

model Coupon {
  id                    String     @id @default(uuid()) @db.Uuid
  storeId               String     @map("store_id") @db.Uuid
  code                  String     @db.Citext
  type                  CouponType
  value                 Decimal    @db.Decimal(12, 2)
  minimumOrderAmount    Decimal?   @map("minimum_order_amount") @db.Decimal(12, 2)
  maximumDiscountAmount Decimal?   @map("maximum_discount_amount") @db.Decimal(12, 2)
  usageLimit            Int?       @map("usage_limit")
  usageCount            Int        @default(0) @map("usage_count")
  /// Max redemptions per store-scoped customer identity (customerId or guest email).
  perCustomerLimit      Int?       @map("per_customer_limit")
  startsAt              DateTime?  @map("starts_at")
  expiresAt             DateTime?  @map("expires_at")
  active                Boolean    @default(true)
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  usages CouponUsage[]

  @@unique([storeId, code])
  @@index([storeId])
  @@index([storeId, active])
  @@map("coupons")
}

model CouponUsage {
  id             String   @id @default(uuid()) @db.Uuid
  couponId       String   @map("coupon_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  customerId     String?  @map("customer_id") @db.Uuid
  discountAmount Decimal  @map("discount_amount") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  coupon   Coupon    @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([couponId, orderId])
  @@index([orderId])
  @@index([customerId])
  @@map("coupon_usages")
}

// ---------------------------------------------------------------------------
// Media / Themes / Domains
// ---------------------------------------------------------------------------

model Media {
  id               String   @id @default(uuid()) @db.Uuid
  storeId          String   @map("store_id") @db.Uuid
  uploadedByUserId String?  @map("uploaded_by_user_id") @db.Uuid
  url              String
  key              String
  filename         String
  mimeType         String   @map("mime_type")
  size             Int
  width            Int?
  height           Int?
  /// File bytes for uploads stored in Postgres (product images, SF-04). Never
  /// select this column in list queries.
  data             Bytes?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  store      Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  uploadedBy User? @relation("MediaUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@unique([storeId, key])
  @@index([storeId])
  @@index([uploadedByUserId])
  @@map("media")
}

model Theme {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  slug            String   @unique @db.Citext
  version         String   @default("1.0.0")
  description     String?
  previewImageUrl String?  @map("preview_image_url")
  configuration   Json?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  storeThemes StoreTheme[]

  @@map("themes")
}

model StoreTheme {
  id                     String    @id @default(uuid()) @db.Uuid
  storeId                String    @map("store_id") @db.Uuid
  themeId                String    @map("theme_id") @db.Uuid
  /// Selected theme for this store (at most one true per store via app logic).
  isActive               Boolean   @default(false) @map("is_active")
  /// Draft configuration edited by merchants (not public until published).
  configuration          Json?
  /// Last published public-safe configuration snapshot.
  publishedConfiguration Json?     @map("published_configuration")
  publishedAt            DateTime? @map("published_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  theme Theme @relation(fields: [themeId], references: [id], onDelete: Restrict)

  @@unique([storeId, themeId])
  @@index([storeId, isActive])
  @@map("store_themes")
}

model Domain {
  id                String       @id @default(uuid()) @db.Uuid
  storeId           String       @map("store_id") @db.Uuid
  hostname          String       @unique @db.Citext
  type              DomainType
  status            DomainStatus @default(PENDING)
  isPrimary         Boolean      @default(false) @map("is_primary")
  /// DNS TXT verification token shown to merchants while PENDING; never public/admin.
  /// SHA-256 hash of DNS challenge token (`sha256:<hex>`). Raw token returned once on create/regenerate only.
  verificationToken String?      @map("verification_token") @db.VarChar(128)
  verifiedAt        DateTime?    @map("verified_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([storeId])
  @@index([storeId, isPrimary])
  @@index([status])
  @@map("domains")
}

// ---------------------------------------------------------------------------
// Subscriptions
// ---------------------------------------------------------------------------

model SubscriptionPlan {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  slug          String   @unique @db.Citext
  description   String?
  monthlyPrice  Decimal  @map("monthly_price") @db.Decimal(12, 2)
  yearlyPrice   Decimal  @map("yearly_price") @db.Decimal(12, 2)
  active        Boolean  @default(true)
  configuration Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  subscriptions   Subscription[]
  billingPayments BillingPayment[]

  @@map("subscription_plans")
}

model Subscription {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  planId       String             @map("plan_id") @db.Uuid
  status       SubscriptionStatus @default(TRIALING)
  billingCycle BillingCycle       @map("billing_cycle")
  startsAt     DateTime           @map("starts_at")
  endsAt       DateTime?          @map("ends_at")
  trialEndsAt  DateTime?          @map("trial_ends_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan            SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  billingPayments BillingPayment[]

  @@index([tenantId])
  @@index([planId])
  @@index([tenantId, status])
  @@map("subscriptions")
}

/// A subscription payment the merchant sent by mobile wallet and reported with
/// its transaction ID. A Super Admin checks it and approves or rejects it;
/// only an approval activates the plan.
model BillingPayment {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  planId            String               @map("plan_id") @db.Uuid
  /// The subscription the approval activated or renewed.
  subscriptionId    String?              @map("subscription_id") @db.Uuid
  billingCycle      BillingCycle         @map("billing_cycle")
  /// Server-calculated price of the plan and billing cycle at submission.
  amount            Decimal              @db.Decimal(12, 2)
  currency          String               @default("BDT")
  method            ManualPaymentMethod
  /// Ecomesta wallet number shown to the merchant when they paid.
  payToNumber       String               @map("pay_to_number")
  senderNumber      String               @map("sender_number")
  transactionId     String               @map("transaction_id") @db.Citext
  status            BillingPaymentStatus @default(PENDING)
  submittedByUserId String               @map("submitted_by_user_id") @db.Uuid
  reviewedByUserId  String?              @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime?            @map("reviewed_at")
  rejectionReason   String?              @map("rejection_reason")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  submittedBy  User             @relation("BillingPaymentSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  reviewedBy   User?            @relation("BillingPaymentReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  /// A wallet transaction ID can only ever be claimed once.
  @@unique([method, transactionId])
  @@index([status, createdAt])
  @@index([tenantId, createdAt])
  @@map("billing_payments")
}

// ---------------------------------------------------------------------------
// Audit & notifications
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  storeId    String?  @map("store_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  store  Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([storeId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String?          @map("tenant_id") @db.Uuid
  storeId   String?          @map("store_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  store  Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([tenantId])
  @@index([storeId])
  @@index([createdAt])
  @@map("notifications")
}

enum EmailDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

/// Transactional email outbox and delivery log. Never holds passwords, tokens
/// or rendered bodies; `payload` keeps non-secret template data only until the
/// delivery reaches a final state, then it is cleared.
model EmailDelivery {
  id                String              @id @default(uuid()) @db.Uuid
  eventType         String              @map("event_type")
  status            EmailDeliveryStatus @default(PENDING)
  idempotencyKey    String?             @unique @map("idempotency_key")
  userId            String?             @map("user_id") @db.Uuid
  tenantId          String?             @map("tenant_id") @db.Uuid
  storeId           String?             @map("store_id") @db.Uuid
  recipientHash     String?             @map("recipient_hash")
  provider          String?
  payload           Json?
  attempts          Int                 @default(0)
  nextAttemptAt     DateTime?           @map("next_attempt_at")
  lockedAt          DateTime?           @map("locked_at")
  sentAt            DateTime?           @map("sent_at")
  failedAt          DateTime?           @map("failed_at")
  errorCategory     String?             @map("error_category")
  providerMessageId String?             @map("provider_message_id")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([userId])
  @@index([tenantId])
  @@index([eventType])
  @@index([createdAt])
  @@map("email_deliveries")
}
