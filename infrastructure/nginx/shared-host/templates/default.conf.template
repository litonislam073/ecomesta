# Ecomesta edge for a shared host (docker-compose.shared-host.yml).
#
# Chain: visitor → Cloudflare (proxied, SSL Full strict) → the host's existing
# web server (terminates TLS, accepts only Cloudflare IPs for these hostnames)
# → this nginx on 127.0.0.1:${ECOMESTA_HTTP_PORT} (plain HTTP) → apps.
#
# The host web server must proxy ${PLATFORM_ROOT_DOMAIN}, www., api., merchant.,
# admin. and *.${PLATFORM_ROOT_DOMAIN} here, keeping the original Host header.
#
# Origin lock-down (QA-002) happens HERE, not in the host web server: the host
# (OpenLiteSpeed) resolves the visitor IP from Cloudflare's header before its
# own ACLs run, so it cannot tell Cloudflare apart from a direct client. It does
# append its real TCP peer as the LAST X-Forwarded-For entry. Every Ecomesta
# server block below answers 403 unless that last hop is a Cloudflare edge, and
# only then is CF-Connecting-IP used as the client address. See
# docs/deployment.md "Shared host".

server_tokens off;
client_max_body_size 2m;
client_body_timeout 30s;
client_header_timeout 30s;
# keepalive_timeout is already 65s in the nginx image's nginx.conf; repeating it here is a startup error.

proxy_connect_timeout 5s;
proxy_send_timeout 60s;
proxy_read_timeout 60s;

gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_proxied any;
gzip_vary on;
gzip_types text/plain text/css application/json application/javascript text/javascript application/xml image/svg+xml;

# No realip module directives: $remote_addr stays the TCP peer (the Docker
# bridge). The client address is $edge_client_ip, set only after validation.

# 1. Last X-Forwarded-For hop = the host web server's real TCP peer. nginx
#    joins repeated X-Forwarded-For headers with ", ". Anything that is not a
#    single token at the very end (trailing comma, spaces inside, …) is "".
map $http_x_forwarded_for $xff_last_hop {
    "~(?:^|,)[ \t]*(?<hop>[^, \t]+)[ \t]*$"  $hop;
    default                                  "";
}

# 2. Is that hop a Cloudflare edge? A value that is not an IP is looked up as
#    255.255.255.255, i.e. "no". Ranges: scripts/nginx-cloudflare-ranges.sh.
#    A missing range file makes `nginx -t` fail (fail closed).
geo $xff_last_hop $xff_last_hop_is_cloudflare {
    default 0;
    include /etc/nginx/cloudflare/cloudflare-geo.conf;
}

# 3. CF-Connecting-IP must be exactly one IPv4 or IPv6 literal.
map $http_cf_connecting_ip $cf_client_ip_wellformed {
    "~^[0-9]{1,3}(\.[0-9]{1,3}){3}$"              1;
    "~^[0-9A-Fa-f]{0,4}(:[0-9A-Fa-f]{0,4}){2,7}$" 1;
    default                                        0;
}

# 4. Trusted only when both hold.
map "$xff_last_hop_is_cloudflare:$cf_client_ip_wellformed" $edge_trusted {
    "1:1"   1;
    default 0;
}

# 5. Effective client IP: CF-Connecting-IP only when trusted, otherwise empty.
map $edge_trusted $edge_client_ip {
    1       $http_cf_connecting_ip;
    default "";
}

limit_req_zone $edge_client_ip zone=storefront:10m rate=30r/s;
limit_req_status 429;

# No query strings, referers, cookies or auth headers.
log_format ecomesta_edge '$edge_client_ip trusted=$edge_trusted last_hop=$xff_last_hop '
                         'peer=$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                         '$status $body_bytes_sent $request_time host=$host "$http_user_agent"';

# Theme editor preview: storefront pages opened with ?theme_preview=… may be
# framed by the merchant dashboard only; every other page stays SAMEORIGIN.
map $arg_theme_preview $storefront_frame_options {
    ""      "SAMEORIGIN";
    default "";
}
map $arg_theme_preview $storefront_frame_ancestors {
    ""      "";
    default "frame-ancestors 'self' https://merchant.${PLATFORM_ROOT_DOMAIN}";
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

upstream ecomesta_api      { server api:3001;      keepalive 32; }
upstream ecomesta_web      { server web:3000;      keepalive 32; }
upstream ecomesta_merchant { server merchant:3002; keepalive 16; }
upstream ecomesta_admin    { server admin:3003;    keepalive 8; }

# Unknown Host: close without a response. Also serves the container healthcheck.
server {
    listen 80 default_server;
    server_name _;

    location = /nginx-health {
        access_log off;
        allow 127.0.0.1;
        allow ::1;
        deny all;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 444;
    }
}

server {
    listen 80;
    server_name api.${PLATFORM_ROOT_DOMAIN};
    access_log /var/log/nginx/access.log ecomesta_edge;
    if ($edge_trusted = 0) { return 403; }

    include /etc/nginx/snippets/deny-hidden.conf;

    location / {
        proxy_pass http://ecomesta_api;
        include /etc/nginx/shared-snippets/proxy.conf;
        # SSLCommerz IPN handling calls the gateway's validation API before
        # answering; allow for a slow upstream round-trip.
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }
}

server {
    listen 80;
    server_name ${PLATFORM_ROOT_DOMAIN} www.${PLATFORM_ROOT_DOMAIN};
    access_log /var/log/nginx/access.log ecomesta_edge;
    if ($edge_trusted = 0) { return 403; }

    include /etc/nginx/snippets/storefront-security-headers.conf;
    include /etc/nginx/snippets/deny-hidden.conf;
    include /etc/nginx/shared-snippets/storefront.conf;
}

# Store subdomains. Exact names (api/www/merchant/admin) take precedence.
server {
    listen 80;
    server_name *.${PLATFORM_ROOT_DOMAIN};
    access_log /var/log/nginx/access.log ecomesta_edge;
    if ($edge_trusted = 0) { return 403; }

    include /etc/nginx/snippets/storefront-security-headers.conf;
    include /etc/nginx/snippets/deny-hidden.conf;
    include /etc/nginx/shared-snippets/storefront.conf;
}

server {
    listen 80;
    server_name merchant.${PLATFORM_ROOT_DOMAIN};
    access_log /var/log/nginx/access.log ecomesta_edge;
    if ($edge_trusted = 0) { return 403; }

    include /etc/nginx/snippets/security-headers.conf;
    add_header X-Robots-Tag "noindex, nofollow" always;
    include /etc/nginx/snippets/deny-hidden.conf;

    location / {
        proxy_pass http://ecomesta_merchant;
        include /etc/nginx/shared-snippets/proxy.conf;
    }
}

server {
    listen 80;
    server_name admin.${PLATFORM_ROOT_DOMAIN};
    access_log /var/log/nginx/access.log ecomesta_edge;
    if ($edge_trusted = 0) { return 403; }

    include /etc/nginx/snippets/security-headers.conf;
    add_header X-Robots-Tag "noindex, nofollow" always;
    include /etc/nginx/snippets/deny-hidden.conf;

    location / {
        proxy_pass http://ecomesta_admin;
        include /etc/nginx/shared-snippets/proxy.conf;
    }
}
