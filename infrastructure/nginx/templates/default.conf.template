# Ecomesta production edge (rendered by the nginx image at container start).
#
# The official nginx image runs envsubst over /etc/nginx/templates/*.template.
# NGINX_ENVSUBST_FILTER restricts substitution to ${PLATFORM_ROOT_DOMAIN};
# nginx runtime variables such as $host are left untouched.
#
# Hostnames follow the convention the apps are configured with:
#   ${PLATFORM_ROOT_DOMAIN}, www.   → web (marketing)
#   *.${PLATFORM_ROOT_DOMAIN}       → web (store subdomains)
#   api.                            → api
#   merchant.                       → merchant dashboard
#   admin.                          → super admin
# Custom store domains get their own server block in /etc/nginx/custom-domains.
#
# TLS certificate (see docs/deployment.md §10): one certificate named
# ${PLATFORM_ROOT_DOMAIN} that covers the apex and *.${PLATFORM_ROOT_DOMAIN}.

server_tokens off;
client_max_body_size 2m;
client_body_timeout 30s;
client_header_timeout 30s;
# keepalive_timeout is already 65s in the nginx image's nginx.conf; repeating it here is a startup error.

proxy_connect_timeout 5s;
proxy_send_timeout 60s;
proxy_read_timeout 60s;

gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_proxied any;
gzip_vary on;
gzip_types text/plain text/css application/json application/javascript text/javascript application/xml image/svg+xml;

limit_req_zone $binary_remote_addr zone=storefront:10m rate=30r/s;
limit_req_status 429;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

upstream ecomesta_api      { server api:3001;      keepalive 32; }
upstream ecomesta_web      { server web:3000;      keepalive 32; }
upstream ecomesta_merchant { server merchant:3002; keepalive 16; }
upstream ecomesta_admin    { server admin:3003;    keepalive 8; }

# ---------------------------------------------------------------------------
# Port 80 — ACME HTTP-01 for any host (custom domains need it before they have
# a certificate), local health probe, everything else → HTTPS.
# ---------------------------------------------------------------------------
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location = /nginx-health {
        access_log off;
        allow 127.0.0.1;
        allow ::1;
        deny all;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------------------
# Port 443 catch-all — unknown SNI is refused; a known SNI with an unknown
# Host header is closed without a response. Nothing is proxied by default.
# ---------------------------------------------------------------------------
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    return 444;
}

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name api.${PLATFORM_ROOT_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${PLATFORM_ROOT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PLATFORM_ROOT_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;

    include /etc/nginx/snippets/deny-hidden.conf;

    location / {
        proxy_pass http://ecomesta_api;
        include /etc/nginx/snippets/proxy.conf;
        # SSLCommerz IPN handling calls the gateway's validation API before
        # answering; allow for a slow upstream round-trip.
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }
}

# ---------------------------------------------------------------------------
# Marketing site (apex + www)
# ---------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${PLATFORM_ROOT_DOMAIN} www.${PLATFORM_ROOT_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${PLATFORM_ROOT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PLATFORM_ROOT_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/security-headers.conf;

    include /etc/nginx/snippets/deny-hidden.conf;
    include /etc/nginx/snippets/storefront.conf;
}

# ---------------------------------------------------------------------------
# Store subdomains ({store}.${PLATFORM_ROOT_DOMAIN}). Exact names above and
# below (api/www/merchant/admin) take precedence over this wildcard.
# ---------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name *.${PLATFORM_ROOT_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${PLATFORM_ROOT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PLATFORM_ROOT_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/security-headers.conf;

    include /etc/nginx/snippets/deny-hidden.conf;
    include /etc/nginx/snippets/storefront.conf;
}

# ---------------------------------------------------------------------------
# Merchant dashboard
# ---------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name merchant.${PLATFORM_ROOT_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${PLATFORM_ROOT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PLATFORM_ROOT_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/security-headers.conf;
    add_header X-Robots-Tag "noindex, nofollow" always;

    include /etc/nginx/snippets/deny-hidden.conf;

    location / {
        proxy_pass http://ecomesta_merchant;
        include /etc/nginx/snippets/proxy.conf;
    }
}

# ---------------------------------------------------------------------------
# Super Admin
# ---------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name admin.${PLATFORM_ROOT_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${PLATFORM_ROOT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PLATFORM_ROOT_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/security-headers.conf;
    add_header X-Robots-Tag "noindex, nofollow" always;

    include /etc/nginx/snippets/deny-hidden.conf;

    location / {
        proxy_pass http://ecomesta_admin;
        include /etc/nginx/snippets/proxy.conf;
    }
}

# Verified custom store domains (one file per domain; see custom-domains/README.md).
include /etc/nginx/custom-domains/*.conf;
