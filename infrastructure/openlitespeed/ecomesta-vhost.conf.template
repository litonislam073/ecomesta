# OpenLiteSpeed virtual host for Ecomesta on a shared host
# (docker-compose.shared-host.yml). Installed at
#   /usr/local/lsws/conf/vhosts/ecomesta.com/vhost.conf
# by scripts/ols-apply-ecomesta-vhost.sh, which fills the accessControl allow
# list with Cloudflare's published ranges. Do not hand-edit the installed copy:
# re-run the script instead.
#
# Why accessControl is not "allow ALL" (QA-002): the Ecomesta nginx trusts
# CF-Connecting-IP as the visitor address. That is only safe when every request
# really came through Cloudflare, so the origin refuses everything else (403).
#
# Why the rewrite (QA-005): with Cloudflare SSL "Full (strict)", an http://
# visitor request reaches this origin on port 80. The Default listener maps
# the apex and www here, and the rule sends them to https:// with the same
# path and query string. Requests that arrived over TLS never match it.

docRoot                   $VH_ROOT/html
vhDomain                  ecomesta.com
vhAliases                 www.ecomesta.com, api.ecomesta.com, merchant.ecomesta.com, admin.ecomesta.com, *.ecomesta.com
adminEmails               root@localhost
enableGzip                0
enableIpGeo               0

errorlog $VH_ROOT/logs/error.log {
  useServer               0
  logLevel                WARN
  rollingSize             10M
}

accesslog $VH_ROOT/logs/access.log {
  useServer               0
  logFormat               "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\""
  rollingSize             10M
  keepDays                10
  compressArchive         1
}

accessControl  {
  allow                   @CLOUDFLARE_ALLOW@
  deny                    ALL
}

rewrite  {
  enable                  1
  rules                   <<<END_rules
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(www\.)?ecomesta\.com$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  END_rules
}

extprocessor ecomesta_edge {
  type                    proxy
  address                 127.0.0.1:8480
  maxConns                200
  initTimeout             60
  retryTimeout            0
  respBuffer              0
}

context / {
  type                    proxy
  handler                 ecomesta_edge
  addDefaultCharset       off
}

vhssl  {
  keyFile                 /etc/ssl/ecomesta/cf-origin.key
  certFile                /etc/ssl/ecomesta/origin.crt
  certChain               0
  sslProtocol             24
  enableECDHE             1
  renegProtection         1
  sslSessionCache         1
  enableSpdy              15
}
