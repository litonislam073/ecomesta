# Ecomesta scheduled backup settings.
# Install as /etc/ecomesta/backup.env, owned by root, mode 0600:
#   install -d -m 700 /etc/ecomesta
#   install -m 600 infrastructure/backup/backup.env.example /etc/ecomesta/backup.env
# The database password is NOT needed here: compose mode runs pg_dump inside
# the postgres container with that container's own credentials.

BACKUP_MODE=compose
COMPOSE_FILE=/opt/ecomesta/docker-compose.prod.yml
ENV_FILE=/opt/ecomesta/.env.production
BACKUP_DIR=/opt/ecomesta/backups
BACKUP_RETENTION_DAYS=14
# Newest dumps that retention never deletes, even if backups stop for weeks.
BACKUP_KEEP_MIN=3
# Refuse to start with less free space than this (MB) or 3× the last dump.
BACKUP_MIN_FREE_MB=1024
BACKUP_LOG_FILE=/var/log/ecomesta-backup.log

# ---------------------------------------------------------------------------
# OFF-HOST COPY — leave BACKUP_OFFHOST_METHOD empty until a destination exists.
# While it is empty every run logs "OFF-HOST NOT CONFIGURED" and the status
# file records offhost_status=not_configured.
# ---------------------------------------------------------------------------
BACKUP_OFFHOST_METHOD=

# Option A — rsync over SSH to another server you control:
# BACKUP_OFFHOST_METHOD=rsync
# BACKUP_OFFHOST_TARGET=backup@backup.example.net:/srv/backups/ecomesta
# BACKUP_OFFHOST_SSH_KEY=/root/.ssh/ecomesta_backup_ed25519
#   (add the target's host key to /root/.ssh/known_hosts first; StrictHostKeyChecking=yes)

# Option B — restic to S3-compatible storage, Backblaze B2, SFTP, …:
# BACKUP_OFFHOST_METHOD=restic
# RESTIC_REPOSITORY=s3:https://s3.example.com/ecomesta-backups
# RESTIC_PASSWORD_FILE=/etc/ecomesta/restic-password   (mode 0600; losing it loses the backups)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# BACKUP_OFFHOST_KEEP_DAILY=14
# BACKUP_OFFHOST_KEEP_WEEKLY=8
# BACKUP_OFFHOST_KEEP_MONTHLY=6
#   (run `restic init` once before the first scheduled backup)
